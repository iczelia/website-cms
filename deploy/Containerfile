# Containerfile for the iczelia.net daemon. Build context: repo root.
#   cd /path/to/iczelia
#   podman build -t iczelia:latest -f deploy/Containerfile .
# Image bundles TeX Live + Perl + the cpanfile deps. State at /var/lib/iczelia.

FROM docker.io/library/debian:bookworm-slim AS base

ENV DEBIAN_FRONTEND=noninteractive

# Runtime packages, then the cpanfile deps (DBI, DBD::SQLite,
# IO::Compress::Brotli are XS; from CPAN since IO::Compress::Brotli isn't
# in Debian). The build toolchain is installed and purged in this layer.
COPY cpanfile /tmp/cpanfile
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        perl \
        libbrotli1 \
        ca-certificates \
        curl \
        sqlite3 \
        texlive-latex-base \
        texlive-latex-recommended \
        texlive-fonts-recommended \
        texlive-latex-extra \
        dvipng \
        dvisvgm \
        tini \
    && apt-get install -y --no-install-recommends \
        cpanminus build-essential libperl-dev libbrotli-dev libcrypt-dev cmake \
    && (cd /tmp && cpanm --notest --installdeps .) \
    && apt-get purge -y --auto-remove cpanminus build-essential libperl-dev libbrotli-dev libcrypt-dev cmake \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /root/.cpanm /tmp/cpanfile

# oxipng isn't in Debian bookworm; pull the matching static-musl binary
# from upstream. Build keeps going on download failure so offline rebuilds
# still produce a working image (zopflipng is then the only optimizer).
ARG OXIPNG_VERSION=9.1.5
RUN set -eu; \
    cd /tmp; \
    case "$(uname -m)" in \
      x86_64)  arch=x86_64-unknown-linux-musl  ;; \
      aarch64) arch=aarch64-unknown-linux-musl ;; \
      *) echo "WARN: no oxipng release for $(uname -m)" >&2; exit 0 ;; \
    esac; \
    tarball="oxipng-${OXIPNG_VERSION}-${arch}.tar.gz"; \
    if curl -fsSLO --max-time 60 \
        "https://github.com/oxipng/oxipng/releases/download/v${OXIPNG_VERSION}/${tarball}"; then \
      tar xzf "$tarball" && \
      install -m 0755 "oxipng-${OXIPNG_VERSION}-${arch}/oxipng" /usr/local/bin/oxipng && \
      /usr/local/bin/oxipng --version; \
    else \
      echo "WARN: oxipng download failed; falling back to zopflipng-only optimization" >&2; \
    fi; \
    rm -rf /tmp/oxipng-*

# Trim TeX a bit (font sources we don't render with --no-fonts; man pages,
# docs, etc.). Saves ~200 MB without affecting math rendering.
RUN rm -rf \
    /usr/share/doc \
    /usr/share/man \
    /usr/share/texlive/texmf-dist/doc \
    /usr/share/texlive/texmf-dist/source

# Non-root user for the runtime
RUN useradd --system --uid 1000 --shell /usr/sbin/nologin --home-dir /var/lib/iczelia iczelia \
    && install -d -o iczelia -g iczelia -m 0755 /var/lib/iczelia /var/lib/iczelia/media /var/lib/iczelia/tmp

WORKDIR /opt/iczelia
COPY bin/    bin/
COPY lib/    lib/
COPY share/  share/
RUN chmod +x bin/iczelia-server bin/iczelia-init bin/iczelia-passwd bin/iczelia-fetch-activity

RUN install -d -o root -g root -m 0755 /etc/iczelia
COPY deploy/iczelia.container.conf /etc/iczelia/iczelia.conf

COPY deploy/entrypoint.sh /usr/local/bin/iczelia-entrypoint
RUN chmod 0755 /usr/local/bin/iczelia-entrypoint

USER iczelia
WORKDIR /var/lib/iczelia
EXPOSE 8731
VOLUME ["/var/lib/iczelia"]

ENTRYPOINT ["/usr/bin/tini", "-g", "--", "/usr/local/bin/iczelia-entrypoint"]
CMD ["server"]
