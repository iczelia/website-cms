# ~/.config/containers/systemd/iczelia.container
#
# Podman Quadlet unit. With this file in place, run:
#
#   systemctl --user daemon-reload
#   systemctl --user enable --now iczelia
#
# Quadlet support requires Podman >=  4.4 (Debian 12 backport, Fedora 38+,
# Ubuntu 24.04+). On older systems use the `podman run` invocation in
# README.md instead.

[Unit]
Description=iczelia.net (Podman)
After=network-online.target
Wants=network-online.target

[Container]
Image=localhost/iczelia:latest
ContainerName=iczelia
PublishPort=127.0.0.1:8731:8731
Volume=iczelia-state:/var/lib/iczelia:Z
# Set if your nginx exposes a loopback purge endpoint:
# Environment=ICZELIA_PURGE_URL=http://host.containers.internal/purge
AutoUpdate=registry

[Service]
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
