[Unit]
Description=iczelia.net dynamic site
After=network.target

[Service]
Type=simple
User=iczelia
Group=iczelia
WorkingDirectory=/opt/iczelia
ExecStart=/opt/iczelia/bin/iczelia-server --config /etc/iczelia/iczelia.conf
Restart=on-failure
RestartSec=2

# Sandbox
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/iczelia /run/iczelia
NoNewPrivileges=true
CapabilityBoundingSet=
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
