# /etc/cron.d/iczelia
# Pull GitHub / Mastodon / Bluesky activity into the activity table every
# 10 minutes. Output goes to syslog via cron's default MTA-less behaviour;
# add MAILTO="" if you don't want any mail.

MAILTO=""
*/10 * * * * iczelia /opt/iczelia/bin/iczelia-fetch-activity --config /etc/iczelia/iczelia.conf
