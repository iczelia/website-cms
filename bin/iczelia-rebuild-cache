# This is run via exec() from the admin "rebuild caches" handler. The
# exec is what lets us reach for SQLite at all: the request worker that
# triggered the rebuild has an open DBD::SQLite handle, and libsqlite
# is not fork-safe — opening a fresh connection from a forked child
# of that worker aborts the process via libsqlite assertion. By
# exec()ing into a clean perl we drop every byte of inherited libsqlite
# state.

use strict;
use warnings;
use FindBin ();
use lib "$FindBin::RealBin/../lib";
use Getopt::Long qw(:config bundling no_auto_abbrev no_ignore_case);
use POSIX        ();

use Iczelia::Config;
use Iczelia::DB;
use Iczelia::Handlers::Admin;

my %opt = (config => '/etc/iczelia/iczelia.conf');
GetOptions('config=s' => \$opt{config})
  or die "iczelia-rebuild-cache: bad options\n";

my $cfg = Iczelia::Config->load(\%opt);

# Own process group so the admin cancel handler can SIGTERM the
# whole rebuild subtree with one kill -PG. Tolerate failure when
# launched from a shell that already gave us a session.
eval {POSIX::setsid()};
eval {POSIX::setpgid(0, 0)};

my $cancelled = 0;
my $on_cancel = sub {
  return if $cancelled++;
  $SIG{TERM} = 'IGNORE';
  eval {
    my $rdb     = Iczelia::DB->connect($cfg);
    my $current = $rdb->setting('cache.rebuild.phase') // '';
    if ($current =~ /^(?:starting|math|html|cancelling)$/) {
      $rdb->set_setting('cache.rebuild.phase',       'cancelled');
      $rdb->set_setting('cache.rebuild.finished_at', time());
    }
    $rdb->set_setting('cache.rebuild.pid', 0);
    $rdb->disconnect;
  };
  POSIX::_exit(0);
};
$SIG{TERM} = $on_cancel;
$SIG{INT}  = $on_cancel;
$SIG{HUP}  = 'IGNORE';

eval {
  my $sdb = Iczelia::DB->connect($cfg);
  $sdb->set_setting('cache.rebuild.pid', $$);
  $sdb->disconnect;
};

eval {Iczelia::Handlers::Admin::Cache::run_rebuild($cfg)};
if ($@) {
  my $err = "$@";
  eval {
    my $rdb = Iczelia::DB->connect($cfg);
    $rdb->set_setting('cache.rebuild.phase',       'error');
    $rdb->set_setting('cache.rebuild.error',       substr($err, 0, 200));
    $rdb->set_setting('cache.rebuild.finished_at', time());
    $rdb->set_setting('cache.rebuild.pid',         0);
    $rdb->disconnect;
  };
}

POSIX::_exit(0);
