use strict;
use warnings;
use FindBin ();
use lib "$FindBin::RealBin/../lib";
use Getopt::Long qw(:config bundling no_auto_abbrev no_ignore_case);

use Iczelia ();
use Iczelia::Config;
use Iczelia::SelfUpdate;

my %opt = (
  config        => '/etc/iczelia/iczelia.conf',
  remote        => undef,
  'tag-prefix'  => undef,
  'restart-cmd' => undef,
  'dry-run'     => 0,
  quiet         => 0,
  help          => 0,
);

GetOptions(
  'config=s'      => \$opt{config},
  'remote=s'      => \$opt{remote},
  'tag-prefix=s'  => \$opt{'tag-prefix'},
  'restart-cmd=s' => \$opt{'restart-cmd'},
  'dry-run|n'     => \$opt{'dry-run'},
  'quiet|q'       => \$opt{quiet},
  'help|h'        => \$opt{help},
) or die "iczelia-update: bad options; --help for usage\n";

if ($opt{help}) {
  print <<'USAGE';
iczelia-update - fast-forward this checkout to the next patch tag

Fetches release tags (`vX.Y.Z` by default) from the remote and picks
the tag whose version is exactly one patch higher than the running
version on the same major.minor (current=0.1.0 -> v0.1.1, never -> v0.1.4).
Anything wider (a minor/major bump, a downgrade, missing intermediate
patch, local edits, diverged history) is reported and left alone.

A single invocation never bumps by more than 0.0.1; chain cron ticks
to walk forward across several releases.

  --config <path>      config file (default: /etc/iczelia/iczelia.conf)
  --remote <name>      git remote to fetch (default: update-remote from
                       config, else 'origin'; empty = no fetch)
  --tag-prefix <s>     tag prefix to match (default: 'v', so 'v1.2.3')
  --restart-cmd <cmd>  shell command run after a successful update
                       (default: update-restart-cmd from config)
  --dry-run, -n        report what would happen; change nothing
  --quiet, -q          stay silent when already up to date
  --help, -h           this message

Exit status: 0 = updated or already current; 1 = skipped (manual
action needed); 2 = error (including a failed restart).
USAGE
  exit 0;
}

# Config is optional -- the updater works on a bare checkout too.
my $cfg = eval {Iczelia::Config->load({config => $opt{config}})};

my $remote =
    defined $opt{remote}                  ? $opt{remote}
  : $cfg && defined $cfg->{'update-remote'} ? $cfg->{'update-remote'}
  :                                         'origin';
my $tag_prefix =
    defined $opt{'tag-prefix'}              ? $opt{'tag-prefix'}
  : $cfg && defined $cfg->{'update-tag-prefix'}
                                            ? $cfg->{'update-tag-prefix'}
  :                                           'v';
my $restart =
    defined $opt{'restart-cmd'} ? $opt{'restart-cmd'}
  : $cfg                        ? $cfg->{'update-restart-cmd'}
  :                               undef;

my $u = Iczelia::SelfUpdate->new(
  repo_dir    => "$FindBin::RealBin/..",
  remote      => $remote,
  tag_prefix  => $tag_prefix,
  restart_cmd => $restart,
);

my $r = $u->run(dry_run => $opt{'dry-run'});

my $line = sprintf 'iczelia-update: %s -- %s', $r->{action}, $r->{reason};
if ($r->{action} eq 'updated' && exists $r->{restarted}) {
  $line .= $r->{restarted} ? '; restarted' : "; $r->{restart_error}";
}

print "$line\n" unless $opt{quiet} && $r->{action} eq 'noop';

if ($r->{action} eq 'updated') {
  exit(exists $r->{restarted} && !$r->{restarted} ? 2 : 0);
}
exit 0 if $r->{action} eq 'noop';
exit 1 if $r->{action} eq 'skip';
exit 2;
